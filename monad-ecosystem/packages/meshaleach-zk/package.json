{
  "name": "@sovereign/meshaleach-zk",
  "version": "0.1.0",
  "description": "Meshaleach Phase 2 SNARK: gate_passed ∧ human_bound (Circom + snarkjs Groth16)",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
