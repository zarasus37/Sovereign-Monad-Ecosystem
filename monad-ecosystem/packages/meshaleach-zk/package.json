    "ceremony:contribute": "node scripts/phase2-contribute.mjs",
    "ceremony:finalize": "node scripts/phase2-contribute.mjs --finalize",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/gateHumanBound.test.ts src/vkeyPin.test.ts"
  },
  "dependencies": {
    "snarkjs": "^0.7.5"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
