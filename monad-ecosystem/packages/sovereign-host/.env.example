# Sovereign Host (Vector 4.3) — copy to .env for local runs
PORT=3001
FRONTEND_URL=http://localhost:5173

# P0 host auth (REQUIRED in non-test environments)
# Both vars are checked at server startup; missing either causes immediate exit.
# SOVEREIGN_API_TOKEN    — bearer token clients send as `Authorization: Bearer <token>`
# SOVEREIGN_PRINCIPAL_ID — principal this host represents; stamped on every
#                          promote-pl / bind-wallet call (body fields are
#                          overwritten, so a caller cannot name a different
#                          principal in the body)
# Generate a strong token with: `openssl rand -hex 32`
SOVEREIGN_API_TOKEN=
SOVEREIGN_PRINCIPAL_ID=principal:host

# Kafka (optional — default off = honest local synthesis)
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092

# Cardia live funding (optional — requires Bootstrap secrets elsewhere)
# CARDIA_FUNDING_LIVE=true
# REDIS_URL=redis://localhost:6379
# MONAD_RPC_URL=
# BOOTSTRAP_PRIVATE_KEY=
# STABLECOIN_CONTRACT=

# Hepar forensic gate (Vector 4.4) — used by Cardia organ process
# HEPAR_AUDIT_MODE=http
# HEPAR_API_URL=http://localhost:3002/api/v1/hepar
# HEPAR_API_KEY=
# HEPAR_MOCK_PORT=3002
