# Meshaleach issuer custody (server-side PoC mint)
# Browser FG UI uses the user's wallet via getFgMintOpts — not these keys.

# Local / dev (never commit real keys)
MESHALEACH_ISSUER_PRIVATE_KEY=0x_your_dedicated_issuer_key

# Production: Azure Key Vault (preferred)
# KEY_VAULT_NAME=your-vault-name
# Secret name in vault: MESHALEACH-ISSUER-KEY

# Optional: only non-production fallback (warned)
# BOOTSTRAP_PRIVATE_KEY=0x...

# When set, @sovereign/meshaleach-zk refuses demo ptau / non-production vkey
# MESHALEACH_REQUIRE_PROD_VKEY=1
