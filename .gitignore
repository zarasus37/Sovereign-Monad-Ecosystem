!logs/audit/signal-stream-traced.jsonl
# Canonical human-authored reward-model preference pairs (spec line 478) — the
# gating training artifact, authored + validate-worksheet-gated before commit.
# See gnosis-training/.gitignore + theo-techno-cosmo/plex/Review/REWARD_MODEL_PREFERENCE_PAIRS_GUIDE.md.
!gnosis-training/data/preference_pairs_ALL.jsonl
*.pdf
*.png
*.jpg
*.jpeg
*.gif
*.mp4
*.mov

# Temp / scratch
tmp/
temp/
scratch/
*.tmp
*.bak

# GitHub CLI binary (kept in .girignore as a manual mirror)
gh.exe

# Semiotic drift artifacts (post-cron, regenerated each cycle)
logs/semiotic_drift/

# Local Claude Code session data (plans, worktrees, settings) — never commit
.claude/

# Runtime logs — prefer local / object store. Keep small committed fixtures via
# explicit negation if needed. Do not grow logs/corpus dumps in git.
logs/data-rail-activation.json
logs/ttc-window/*.jsonl
logs/paper-trading/
logs/gnosis/*.jsonl
logs/corpus/
logs/classifier*/
monad-ecosystem/logs/
# Allow gnosis markdown reports + pair_coverage md/json if already used as artifacts
!logs/gnosis/*.md
!logs/gnosis/pair_coverage*.json
!logs/gnosis/core_resonance*.json
!logs/gnosis/identity_factory*.json

scripts/node_modules/
scripts/package-lock.json
scripts/package.json
scripts/meshaleach-shots/

