# The Sovereign root ignore file

# Secrets / secret-adjacent (P0 hygiene — never re-commit)
.env
.env.*
!.env.example
!**/.env.example
credentials.json
*.pem
*.key
*.secret
secrets/
keys/
**/local.settings.json
**/*scout-key*.json
# Deploy proofs / runtime state (local or archive patterns)
**/.runtime_state/
**/phase1a.deploy.json
**/*mainnet-proof*.json

# x402-bridge cost ledger (per-call drawdown accounting; gitignored, never committed)
.x402_ledger.jsonl
*.x402_ledger.jsonl

# Python
__pycache__/
*.py[cod]
*.so
.Python
.venv/
.venv*/
venv/
ENV/
env/
.tox/
.coverage
.coverage.*
.hypothesis/
.pytest_cache/
htmlcov/
