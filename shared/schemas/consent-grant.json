{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://the-sovereign/schemas/consent-grant.json",
  "title": "ConsentGrant",
  "description": "Phase 0 consent-graded authorization for one data layer × purpose. Revocable. See consent-graded-data-exchange whitepaper + ZKP/README.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "layer",
    "purpose",
    "granted_at",
    "status",
    "signature",
    "population"
  ],
  "properties": {
    "schema_version": { "const": "consent.v1" },
    "grant_id": { "type": "string", "minLength": 1 },
    "principal_id": { "type": "string", "minLength": 1 },
    "principal_commitment": { "type": "string", "minLength": 1 },
    "layer": {
      "type": "string",
      "enum": ["I", "II", "III", "IV", "V"],
      "description": "Consent data layers I–V (interactional → biometric)."
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "description": "Purpose scope string, e.g. shaliah.coach | data-rail.revenue | research.aggregate"
    },
    "granted_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": ["string", "null"], "format": "date-time" },
    "revoked_at": { "type": ["string", "null"], "format": "date-time" },
    "status": {
      "type": "string",
      "enum": ["active", "expired", "revoked"]
    },
    "signature": { "type": "string", "minLength": 1 },
    "population": {
      "type": "string",
      "enum": ["shaliah", "autonomous"]
    }
  },
  "anyOf": [
    { "required": ["principal_id"] },
    { "required": ["principal_commitment"] }
  ]
}
